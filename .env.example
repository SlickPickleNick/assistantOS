# Database Configuration
# Local / Railway Testing uses SQLite (auto-pushed & seeded on start):
DATABASE_URL="file:./dev.db"
# For persistent Railway SQLite storage, mount a Volume to /data and use:
# DATABASE_URL="file:/data/app.db"
# Or for Railway PostgreSQL, connect the dynamic variable:
# DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Authentication & Session Secret
NEXTAUTH_SECRET="hotel-concierge-super-secret-jwt-key-2026"
# On Railway, you can use the dynamic public domain variable:
# NEXTAUTH_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}"
NEXTAUTH_URL="http://localhost:3000"

# Guest OAuth Providers (Optional; Guest Demo button and Admin Login work out of the box)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Initial Team Administrator Credentials (Auto-seeded into database)
DEFAULT_ADMIN_USERNAME="admin"
DEFAULT_ADMIN_PASSWORD="HotelAdmin2026!"
DEFAULT_ADMIN_EMAIL="admin@luxuryhotel.demo"

